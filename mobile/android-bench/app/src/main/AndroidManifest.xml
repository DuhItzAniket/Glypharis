<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No permissions and no network: the app reads and writes only its own external files folder.
        The onnxruntime-android package asks for these two and starts a telemetry client; all three
        are removed from the merged manifest, and the package's own files are not changed.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:label="Glypharis bench">

        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <!--
            Started by adb with an explicit component; there is no launcher entry. The adb shell
            holds DUMP and ordinary apps do not, so other apps on the phone cannot start it.
        -->
        <activity
            android:name=".BenchActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
